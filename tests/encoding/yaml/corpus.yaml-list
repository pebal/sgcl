#%%% yaml directive
%YAML 1.2
---
x: y
#%%% long lines and unicode
zażółć: gęślą jaźń
日本語: テスト
emoji: "😀"
#%%% trailing spaces
a: b   
c: 'd'   
#%%% plain with trailing colon in flow
[a:, b]
#%%% block mapping in sequence with nested
- name: x
  items:
  - 1
  - 2
  map:
    k: v
#%%% windows line endings
a: 1
b:
  - x
  - y
#%%% comment after key
key:    # comment
  value
other: # c
  - a # c
#%%% anchors on keys and aliases as keys
&k key: &v value
*k : x
? *v
: y
#%%% alias in flow
- &a [1, 2]
- [*a, *a]
- {x: *a}
#%%% block scalar keep with trailing empty lines at end
- |+
  a


#%%% block scalar literal leading empty lines
- |


  text
#%%% block scalar indicator after chomping
- |-2
    two spaces
- |+1
 one
#%%% folded with leading spaces lines
>
  a
   b
  c

  d
#%%% folded literal tabs
>
  a	b
  	c
#%%% plain with colons
- a:b:c
- url: http://x.y/z
- time: 12:30:00
- ::vector
- "x": y
#%%% plain with dash and question
- -a
- --b
- ?c
- - d
#%%% quoted keys
"a b": 1
'c d': 2
"": empty key
#%%% flow mapping implicit null values
{a, b: c, ? d}
#%%% flow sequence with explicit pair
[? a : b, ? c]
#%%% flow in block nested
a:
  - [b, {c: d}]
  - {e: [f, g]}
#%%% multi-line flow mapping
{ a: b,
  c: d,
  e:
    f
}
