  {"description": "unevaluatedItems sees nested items", "schema": {"allOf": [{"items": true}], "unevaluatedItems": false}, "tests": [
    {"data": [1, 2, 3], "valid": true}]},
  {"description": "$anchor in a nested resource", "schema": {"$id": "https://example.com/a.json",
      "$defs": {"b": {"$id": "b.json", "$defs": {"c": {"$anchor": "here", "type": "null"}}}}, "$ref": "b.json#here"}, "tests": [
    {"data": null, "valid": true}, {"data": 0, "valid": false}]},
  {"description": "$ref to an anchor is not to the same name elsewhere", "schema": {"$id": "https://example.com/a.json",
      "$defs": {"x": {"$anchor": "t", "type": "string"}, "other": {"$id": "other.json", "$defs": {"y": {"$anchor": "t", "type": "integer"}}}},
      "properties": {"p": {"$ref": "#t"}, "q": {"$ref": "other.json#t"}}}, "tests": [
    {"data": {"p": "s", "q": 1}, "valid": true}, {"data": {"p": 1}, "valid": false}, {"data": {"q": "s"}, "valid": false}]},
  {"description": "$ref to a property's subschema by pointer", "schema": {"properties": {"a": {"type": "integer"}, "b": {"$ref": "#/properties/a"}}}, "tests": [
