  {"description": "$ref into prefixItems by index", "schema": {"prefixItems": [{"type": "integer"}, {"$ref": "#/prefixItems/0"}]}, "tests": [
    {"data": [1, 2], "valid": true}, {"data": [1, "2"], "valid": false}]},
  {"description": "$dynamicRef in the same resource", "schema": {"$id": "https://example.com/d.json", "$dynamicAnchor": "x", "type": ["integer", "array"],
      "items": {"$dynamicRef": "#x"}}, "tests": [
    {"data": [1, [2, [3]]], "valid": true}, {"data": [1, ["a"]], "valid": false}]},
  {"description": "type with fractions of big numbers", "schema": {"type": "integer"}, "tests": [
    {"data": 123456789012345678901234567890.0, "valid": true}, {"data": 12345678.5, "valid": false}]},
  {"description": "multipleOf of decimals exactly", "schema": {"multipleOf": 0.1}, "tests": [
    {"data": 0.3, "valid": true}, {"data": 1.1, "valid": true}, {"data": 0.35, "valid": false}, {"data": 12345.6, "valid": true}]}
