    {"data": {"a": {"b": []}}, "valid": false}]},
  {"description": "const null", "schema": {"const": null}, "tests": [
    {"data": null, "valid": true}, {"data": 0, "valid": false}, {"data": "", "valid": false}, {"data": false, "valid": false}]},
  {"description": "maxLength 0", "schema": {"maxLength": 0}, "tests": [
    {"data": "", "valid": true}, {"data": " ", "valid": false}]},
  {"description": "uniqueItems of nested values", "schema": {"uniqueItems": true}, "tests": [
    {"data": [{"a": [1, 2]}, {"a": [2, 1]}], "valid": true}, {"data": [{"a": [1, 2]}, {"a": [1.0, 2.0]}], "valid": false},
    {"data": [["a"], "a"], "valid": true}, {"data": [1, true], "valid": true}, {"data": [{}, []], "valid": true}]},
  {"description": "required empty", "schema": {"required": []}, "tests": [{"data": {}, "valid": true}]},
  {"description": "prefixItems longer than the array", "schema": {"prefixItems": [{"type": "integer"}, {"type": "integer"}, {"type": "integer"}]}, "tests": [
    {"data": [1], "valid": true}, {"data": [1, 2, 3, "x"], "valid": true}, {"data": [1, "x"], "valid": false}]},
  {"description": "unevaluatedItems through if then", "schema": {"if": {"prefixItems": [{"const": "a"}]}, "then": {"prefixItems": [true, {"const": "b"}]}, "unevaluatedItems": false}, "tests": [
    {"data": ["a", "b"], "valid": true}, {"data": ["a", "b", "c"], "valid": false}, {"data": ["x"], "valid": false}, {"data": [], "valid": true}]},
  {"description": "unevaluatedProperties through dependentSchemas", "schema": {"dependentSchemas": {"a": {"properties": {"b": true}}}, "properties": {"a": true}, "unevaluatedProperties": false}, "tests": [
    {"data": {"a": 1, "b": 2}, "valid": true}, {"data": {"b": 2}, "valid": false}]},
  {"description": "unevaluatedProperties with patternProperties", "schema": {"patternProperties": {"^x": true}, "unevaluatedProperties": false}, "tests": [
    {"data": {"xa": 1}, "valid": true}, {"data": {"ya": 1}, "valid": false}]},
  {"description": "unevaluatedProperties after additionalProperties", "schema": {"additionalProperties": true, "unevaluatedProperties": false}, "tests": [
