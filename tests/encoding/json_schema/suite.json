  {"description": "additionalProperties alone", "schema": {"additionalProperties": {"type": "integer"}}, "tests": [
    {"data": {"a": 1, "b": 2}, "valid": true}, {"data": {"a": "1"}, "valid": false}, {"data": {}, "valid": true}]},
  {"description": "property names of the object's prototype", "schema": {"properties": {"__proto__": {"type": "number"}, "toString": {"type": "string"}, "constructor": {"type": "number"}}}, "tests": [
    {"data": {"__proto__": 1, "toString": "s", "constructor": 2}, "valid": true}, {"data": {"__proto__": "x"}, "valid": false}, {"data": {}, "valid": true}]},
  {"description": "integers written with exponents and fractions", "schema": {"type": "integer"}, "tests": [
    {"data": 1.0e2, "valid": true}, {"data": 1.5e1, "valid": true}, {"data": 1.25e1, "valid": false}, {"data": -0.0, "valid": true}, {"data": 1e-1, "valid": false}]},
  {"description": "enum of nested values", "schema": {"enum": [[[1]], {"a": {"b": [null]}}]}, "tests": [
