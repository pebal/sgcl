#%%% empty
#%%% comments and blank lines
# a comment

   # an indented comment
A=1
#%%% plain values
A=1
B=hello
C=http://example.com/path?x=1
D=a,b,c
E=--flag
#%%% empty values
A=
B=''
C=""
#%%% export
export A=1
export B='two'
export	C="three"
#%%% comments after values
A=1 # one
B='two' # two
C="three"	# three
D=#notacomment
E= # empty
#%%% single quotes are literal
A='$HOME ${X} \n \t # not a comment'
B='"double" inside'
#%%% single quotes over lines
A='line one
line two

line four'
#%%% double quotes over lines
A="line one
line two"
#%%% double quotes keep single ones
A="it's"
#%%% expansion of earlier keys
A=one
B=$A
C=${A}
D="${A}-$A"
E=${A}${A}$A
F="pre${A}post"
#%%% expansion of unset names
A=$NOPE
B="${NOPE}"
C=x${NOPE}y
#%%% defaults
A=one
B=${A:-default}
C=${NOPE:-default}
D=${NOPE-default}
E=
F=${E:-colon}
G=${E-nocolon}
H="${NOPE:-two words}"
#%%% alternates
A=one
E=
B=${A:+alt}
C=${NOPE:+alt}
D=${E:+alt}
F=${E+alt}
G=${NOPE+alt}
#%%% nested defaults
A=one
B=${NOPE:-$A}
C=${NOPE:-${A}}
D=${NOPE:-${ALSO:-deep}}
E="${NOPE:-x${A}y}"
#%%% dollar alone
A=$
B=cost$
C="$ 5"
#%%% redefinition uses the earlier value
A=1
A=${A}2
B=$A
#%%% last wins
A=1
B=2
A=3
#%%% underscores and digits in keys
_A=1
A_B_9=2
a=3
#%%% crlf lines
A=1
B='two'
C="three"
#%%% unicode
A=zażółć
B='日本語'
C="😀 ${B}"
#%%% end
