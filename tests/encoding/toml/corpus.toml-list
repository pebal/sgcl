  1,
  2, # this is ok
]
empty = [ ]
empty2 = [
]
nested = [[[]]]
#%%% arrays comments everywhere
a = [ # c
  # c
  1 # c
  , # c
  2 # c
  # c
] # c
#%%% arrays no comma
a = [1 2]
#%%% arrays leading comma
a = [,1]
#%%% arrays double comma
a = [1,,2]
#%%% arrays only comma
a = [,]
#%%% arrays unclosed
a = [1, 2
#%%% arrays unclosed at end
a = [1,#%%% tables
[table-1]
key1 = "some string"
key2 = 123

[table-2]
key1 = "another string"
key2 = 456
#%%% tables dotted header
[dog."tater.man"]
type.name = "pug"
#%%% tables whitespace in header
[a.b.c]            # this is best practice
[ d.e.f ]          # same as [d.e.f]
[ g .  h  . i ]    # same as [g.h.i]
[ j . "ʞ" . 'l' ]  # same as [j."ʞ".'l']
#%%% tables implicit super
[x.y.z.w] # for this to work

[x] # defining a super-table afterward is ok
#%%% tables defined twice
[fruit]
apple = "red"

[fruit]
orange = "orange"
#%%% tables defined twice via subtable
[fruit]
apple = "red"

[fruit.apple]
texture = "smooth"
#%%% tables out of order
[fruit.apple]
[animal]
[fruit.orange]
#%%% tables root before header
# Top-level table begins.
name = "Fido"
breed = "pug"

# Top-level table ends.
[owner]
name = "Regina Dogman"
member_since = 1999-08-04
#%%% tables dotted keys define
fruit.apple.color = "red"
# Defines a table named fruit
# Defines a table named fruit.apple

fruit.apple.taste.sweet = true
# Defines a table named fruit.apple.taste
# fruit and fruit.apple were already created
#%%% tables header over dotted
[fruit]
apple.color = "red"
apple.taste.sweet = true

[fruit.apple]  # INVALID
#%%% tables header over dotted nested
[fruit]
apple.color = "red"
apple.taste.sweet = true

[fruit.apple.taste]  # INVALID
#%%% tables sub-table of dotted
[fruit]
apple.color = "red"
apple.taste.sweet = true

[fruit.apple.texture]  # you can add sub-tables
smooth = true
#%%% tables dotted over header
[a.b.c]
z = 9

[a]
b.c.t = "Using dotted keys to add to [a.b.c] after explicitly defining it above is not allowed"
#%%% tables dotted over header 2
[a.b.c.d]
z = 9

[a]
b.c.d.k.t = "Using dotted keys to add to [a.b.c.d] after explicitly defining it above is not allowed"
#%%% tables dotted over implicit
[x.y.w]
[x]
y.z = 1
#%%% tables empty header
[]
#%%% tables header unclosed
[a
#%%% tables header with value after
[a] b = 1
#%%% tables header over value
a = 1
[a]
#%%% tables header through value
a = 1
[a.b]
#%%% tables header empty part
[a..b]
#%%% tables header trailing dot
[a.]
#%%% tables header with newline
[a
.b]
#%%% inline tables
name = { first = "Tom", last = "Preston-Werner" }
point = { x = 1, y = 2 }
animal = { type.name = "pug" }
empty = {}
spaced = {  }
nested = { a = { b = { c = 1 } }, d = [ { e = 2 } ] }
#%%% inline tables equivalent
[name]
first = "Tom"
last = "Preston-Werner"

[point]
x = 1
y = 2

[animal]
type.name = "pug"
#%%% inline tables extended by header
[product]
type = { name = "Nail" }
[product.type]
edible = false
#%%% inline tables extended by dotted
[product]
type = { name = "Nail" }
type.edible = false  # INVALID
#%%% inline tables newline
a = { x = 1,
      y = 2 }
#%%% inline tables trailing comma
a = { x = 1, }
#%%% inline tables duplicate
a = { x = 1, x = 2 }
#%%% inline tables dotted duplicate
a = { x.y = 1, x = 2 }
#%%% inline tables dotted sibling
a = { x.y = 1, x.z = 2 }
#%%% inline tables array spanning lines inside
a = { x = [
  1, 2
] }
#%%% inline tables no comma
a = { x = 1 y = 2 }
#%%% inline tables unclosed
a = { x = 1
#%%% inline tables extended by subheader
a = { b = 1 }
[a.c]
#%%% inline tables nested extended by header
a = { b = { c = 1 } }
[a.b.d]
#%%% arrays of tables
[[products]]
name = "Hammer"
sku = 738594937

[[products]]  # empty table within the array

[[products]]
name = "Nail"
sku = 284758393

color = "gray"
#%%% arrays of tables nested
[[fruits]]
name = "apple"

[fruits.physical]  # subtable
color = "red"
shape = "round"

[[fruits.varieties]]  # nested array of tables
name = "red delicious"

[[fruits.varieties]]
name = "granny smith"


[[fruits]]
name = "banana"

[[fruits.varieties]]
name = "plantain"
#%%% arrays of tables subtable before parent
[fruit.physical]  # subtable, but to which parent element should it belong?
color = "red"
shape = "round"

[[fruit]]  # parser must throw an error upon discovering that "fruit" is
           # an array rather than a table
name = "apple"
#%%% arrays of tables over static array
fruits = []

[[fruits]] # Not allowed
#%%% arrays of tables then table same name
[[fruits]]
name = "apple"

[[fruits.varieties]]
name = "red delicious"

# INVALID: This table conflicts with the previous array of tables
[fruits.varieties]
name = "granny smith"
#%%% arrays of tables table then array same name
[[fruits]]
name = "apple"

[fruits.physical]
color = "red"
shape = "round"

# INVALID: This array of tables conflicts with the previous table
[[fruits.physical]]
color = "green"
