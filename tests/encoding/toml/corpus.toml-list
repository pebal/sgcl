#%%% floats leading zero
a = 03.14
#%%% floats exponent underscore
a = 1e1_0
#%%% floats underscore before dot
a = 1_.5
#%%% floats Inf capital
a = Inf
#%%% floats nan capital
a = NaN
#%%% floats double sign
a = +-1.0
#%%% floats exponent empty
