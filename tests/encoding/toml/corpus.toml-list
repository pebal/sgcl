#%%% datetimes local
ldt1 = 1979-05-27T07:32:00
ldt2 = 1979-05-27T00:32:00.999999
ldt3 = 1979-05-27 07:32:00.5
#%%% dates local
ld1 = 1979-05-27
ld2 = 2000-02-29
ld3 = 9999-12-31
ld4 = 0001-01-01
#%%% times local
lt1 = 07:32:00
lt2 = 00:32:00.999999
lt3 = 23:59:59.123456
lt4 = 00:00:00
#%%% datetimes fraction past microseconds
a = 1979-05-27T00:32:00.999999999-07:00
b = 07:32:00.1234567
#%%% datetimes in arrays
a = [1979-05-27, 07:32:00, 1979-05-27T07:32:00Z, 1979-05-27 07:32:00]
#%%% datetimes date then comment
a = 1979-05-27 # comment
#%%% datetimes no seconds
a = 1979-05-27T07:32Z
#%%% datetimes local time no seconds
a = 07:32
#%%% datetimes feb 30
a = 1979-02-30
#%%% datetimes feb 29 not leap
a = 1900-02-29
#%%% datetimes month 13
a = 1979-13-01
#%%% datetimes hour 24
a = 24:00:00
#%%% datetimes minute 60
a = 1979-05-27T07:60:00
#%%% datetimes offset hour 24
a = 1979-05-27T07:32:00+24:00
#%%% datetimes empty fraction
a = 1979-05-27T07:32:00.Z
#%%% datetimes short year
a = 979-05-27
#%%% datetimes time with offset
a = 07:32:00Z
#%%% datetimes two spaces
a = 1979-05-27  07:32:00
#%%% datetimes trailing garbage
a = 1979-05-27T07:32:00Zx
#%%% datetimes offset without colon
a = 1979-05-27T07:32:00+0700
#%%% arrays
integers = [ 1, 2, 3 ]
colors = [ "red", "yellow", "green" ]
nested_arrays_of_ints = [ [ 1, 2 ], [3, 4, 5] ]
nested_mixed_array = [ [ 1, 2 ], ["a", "b", "c"] ]
string_array = [ "all", 'strings', """are the same""", '''type''' ]
numbers = [ 0.1, 0.2, 0.5, 1, 2, 5 ]
contributors = [
  "Foo Bar <foo@example.com>",
  { name = "Baz Qux", email = "bazqux@example.com", url = "https://example.com/bazqux" }
]
