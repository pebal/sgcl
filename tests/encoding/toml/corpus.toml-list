points = [ { x = 1, y = 2, z = 3 },
           { x = 7, y = 8, z = 9 },
           { x = 2, y = 4, z = 8 } ]
#%%% arrays of tables header over inline array
a = [{ b = 1 }]
[[a]]
#%%% arrays of tables subtable of inline array element
a = [{ b = 1 }]
[a.c]
#%%% arrays of tables unclosed
[[a]
#%%% arrays of tables spaces between brackets
[ [a] ]
#%%% whitespace crlf
a = 1
b = "x"
[t]
c = [
1,
2
]
#%%% whitespace lone cr
a = 1b = 2
#%%% whitespace tabs
	a	=	1	
	[	t	]	
	b	=	2
#%%% control in comment
# bad comment
#%%% del in comment
# bad comment
#%%% control in literal
a = 'bad char'
#%%% del in string
a = "bad char"
#%%% control in multi literal
a = '''bad␀ char'''
#%%% value missing
a =
#%%% value unknown
a = what
#%%% value then garbage
a = 1 2
#%%% value string then garbage
a = "x" y
#%%% newline required between pairs
a = 1, b = 2
#%%% deep arrays
a = [[[[[[[[[[[[[[[[[[[[[[[[[[[[[[1]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]
#%%% deep tables
a.b.c.d.e.f.g.h.i.j.k.l.m.n.o.p = 1
[q.r.s.t.u.v.w.x.y.z]
