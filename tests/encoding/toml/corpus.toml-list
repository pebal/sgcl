regex2 = '''I [dw]on't need \d{2} apples'''
lines  = '''
The first newline is
trimmed in raw strings.
   All other whitespace
   is preserved.
'''
#%%% strings multi-line literal quotes
quot15 = '''Here are fifteen quotation marks: """""""""""""""'''
apos15 = "Here are fifteen apostrophes: '''''''''''''''"
str = ''''That,' she said, 'is still pointless.''''
#%%% strings multi-line literal too many
apos15 = '''Here are fifteen apostrophes: ''''''''''''''''''
#%%% strings newline in basic
str = "a
b"
#%%% strings newline in literal
str = 'a
b'
#%%% strings unterminated
str = "abc
#%%% strings unterminated at end
str = "abc#%%% strings unterminated multi
str = """abc
#%%% strings control in basic
str = "abc"
